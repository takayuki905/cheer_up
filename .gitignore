# ----------------------------------------------------------------------
# 依存関係 (Dependencies)
# ----------------------------------------------------------------------

# プロジェクトの依存関係がインストールされるディレクトリ
node_modules
# Macなどで古いnpmのインストール時に生成されるファイル
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# pnpmのロックファイルや設定ファイル
pnpm-lock.yaml
pnpm-debug.log*

# pnpm が生成するキャッシュやリンクのディレクトリ
# .pnpm-store

# ----------------------------------------------------------------------
# ビルド出力とコンパイルされたコード (Build/Artifacts)
# ----------------------------------------------------------------------

# JavaScript/TypeScriptのビルド出力ディレクトリ (プロジェクトによって調整してください)
dist
build
out
# 一時ファイル
tmp

# TypeScriptの出力
*.tsbuildinfo

# ----------------------------------------------------------------------
# エディタとOSの設定ファイル (OS/Editor Specific)
# ----------------------------------------------------------------------

# macOSのサムネイル用ファイル
.DS_Store
# Vimスワップファイル
*.swp
# JetBrains系IDE (WebStorm, IntelliJ IDEAなど)
.idea
# VS Codeの設定ディレクトリ（プロジェクト固有の設定のみを無視）
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# VS Codeのローカルストレージ
.vscode/pnp.*

# ----------------------------------------------------------------------
# 環境設定と機密情報 (Config/Secrets)
# ----------------------------------------------------------------------

# 環境変数ファイル (本番・テスト環境の機密情報を含むため、Gitに含めない)
.env
.env.local
.env.*.local

# ----------------------------------------------------------------------
# テストとカバレッジ (Testing)
# ----------------------------------------------------------------------

# テストカバレッジレポートのディレクトリ (例: Jest, Istanbul)
coverage

# ----------------------------------------------------------------------
# その他 (Misc)
# ----------------------------------------------------------------------

# エディタが作成する一時的なバックアップファイル
*~
# テスト時のダンプファイル
*.dump

# ----------------------------------------------------------------------
# ログファイル
# ----------------------------------------------------------------------
*.log
